    "test": "tsx --test src/tests/*.test.ts src/tests/**/*.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@types/better-sqlite3": "^9.6.0",
