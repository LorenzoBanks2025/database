{
  "name": "@nfa/database",
  "version": "1.0.0",
  "description": "SQLite database, schema, types, and data models.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
